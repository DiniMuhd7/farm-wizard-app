MONGO_URI=
JWT_SECRET=
PORT=
# Twilio Voice (set these only in the backend deployment environment)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Comma-separated E.164 prefixes that may be dialed, for example +234,+44
TWILIO_ALLOWED_DESTINATION_PREFIXES=
# Actual deployed backend base URL, without a trailing slash.
# Used for checkout success/cancel/redirect URLs and provider webhook callbacks.
# Register these exact webhooks in provider dashboards:
#   ${PUBLIC_BASE_URL}/api/v1/payments/stripe/webhook
#   ${PUBLIC_BASE_URL}/api/v1/payments/flutterwave/webhook
PUBLIC_BASE_URL=
# Stripe checkout + webhook verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flutterwave checkout + webhook verification
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# Phone-number checkout pricing
NUMBER_PRICE_USD_CENTS=500
NUMBER_PRICE_NGN=3000
# Pay As You Go: price per minute for 9tel-to-carrier calls, in whole US cents
CREDITS_RATE_PER_MINUTE_CENTS=9
# Premium (ad-free 9tel-to-9tel calling), one 30-day period per purchase.
PREMIUM_PRICE_USD_CENTS=499
PREMIUM_PRICE_NGN=2500
