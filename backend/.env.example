MONGO_URI=
JWT_SECRET=
PORT=
# Twilio Voice (set these only in the backend deployment environment)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Comma-separated E.164 prefixes that may be dialed, for example +234,+44
TWILIO_ALLOWED_DESTINATION_PREFIXES=
# Actual deployed backend base URL, without a trailing slash.
# Used for checkout success/cancel/redirect URLs and provider webhook callbacks.
# Register this exact webhook in the Flutterwave dashboard:
#   ${PUBLIC_BASE_URL}/api/v1/payments/flutterwave/webhook
PUBLIC_BASE_URL=
# Optional local/test-only caller-ID shortcut. It is ignored whenever NODE_ENV=production.
# Only explicitly allowlisted E.164 numbers can use the synthetic test state.
CALLER_ID_DEV_TEST_MODE=false
CALLER_ID_DEV_TEST_NUMBERS=
# Flutterwave (the only payment provider; users pay in USD or NGN)
# FLW_SECRET_HASH must match the "secret hash" set for the webhook in the dashboard
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# USD -> NGN exchange-rate source; NGN checkout prices are the USD price at this
# rate (falls back to fixed NGN prices if unset/unreachable). Response must
# contain rates.NGN.
FX_RATE_URL=https://open.er-api.com/v6/latest/USD
# Phone-number checkout pricing
NUMBER_PRICE_USD_CENTS=500
NUMBER_PRICE_NGN=3000
# Legacy fallback for carrier call pricing, in whole US cents per minute.
CREDITS_RATE_PER_MINUTE_CENTS=9
# Premium (ad-free 9tel-to-9tel calling), one 30-day period per purchase.
PREMIUM_PRICE_USD_CENTS=499
PREMIUM_PRICE_NGN=2500
# Carrier calls use Twilio's account-specific per-number Voice Pricing API.
# Used only if that API is temporarily unavailable, in whole USD cents/minute.
CARRIER_RATE_PER_MINUTE_CENTS=9
# Whole USD cents/minute charged for a Twilio Client-to-Client call.
TWILIO_APP_TO_APP_RATE_PER_MINUTE_CENTS=1
